&GLOBAL
  PROJECT melamine_test
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT
    &QS
      METHOD DFTB
      &DFTB
        SELF_CONSISTENT .TRUE.
        ORTHOGONAL_BASIS .FALSE.
        DO_EWALD .FALSE.
        &PARAMETER
          PARAM_FILE_PATH /Users/mackenziehenley/cp2k/Melamine/CP2K_mel/3ob-3-1
          PARAM_FILE_NAME scc_parameter
          UFF_FORCE_FIELD uff_table
        &END PARAMETER
      &END DFTB
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-5
      MAX_SCF 500
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
      &END MIXING
      ADDED_MOS 20
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 1000
      &END SMEAR
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
    &END SCF
  &END DFT

  &SUBSYS
    &CELL
      A     10.433000      0.000000      0.000000
      B      0.000000      7.458000      0.000000
      C     -2.862958      0.000000      6.647715
      PERIODIC XYZ
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME melamine_crystal.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY

    &KIND C
    &END KIND
    &KIND N
    &END KIND
    &KIND H
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
