&GLOBAL
  PROJECT melamine_nvt
  RUN_TYPE MD
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    &QS
      METHOD DFTB
      &DFTB
        SELF_CONSISTENT .TRUE.
        ORTHOGONAL_BASIS .FALSE.
        DISPERSION .TRUE.
        DO_EWALD .TRUE.
        HB_SR_GAMMA .TRUE.
        &PARAMETER
          PARAM_FILE_PATH /Users/mackenziehenley/cp2k/Melamine/CP2K_mel/3ob-3-1
          PARAM_FILE_NAME scc_parameter
          UFF_FORCE_FIELD uff_table
        &END PARAMETER
      &END DFTB
    &END QS

    &SCF
      SCF_GUESS RESTART
      EPS_SCF 1.0E-5
      MAX_SCF 300
      &MIXING
        METHOD PULAY_MIXING
        ALPHA 0.2
        NPULAY 8
      &END MIXING
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      A     10.433000      0.000000      0.000000
      B      0.000000      7.458000      0.000000
      C     -2.862958      0.000000      6.647715
      PERIODIC XYZ
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME melamine_crystal.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY

    &KIND C
      DFTB3_PARAM -0.1492
    &END KIND
    &KIND N
      DFTB3_PARAM -0.1535
    &END KIND
    &KIND H
      DFTB3_PARAM -0.1857
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE NVT
    STEPS 4000
    TIMESTEP 0.5
    TEMPERATURE 300.0
    &THERMOSTAT
      TYPE NOSE
      &NOSE
        LENGTH 3
        TIMECON 100.0
      &END NOSE
    &END THERMOSTAT
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 10
      &END EACH
    &END TRAJECTORY
    &VELOCITIES
      &EACH
        MD 10
      &END EACH
    &END VELOCITIES
    &ENERGIES
      &EACH
        MD 1
      &END EACH
    &END ENERGIES
    &RESTART
      &EACH
        MD 500
      &END EACH
    &END RESTART
  &END PRINT
&END MOTION
