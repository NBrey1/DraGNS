&GLOBAL
  PROJECT melamine_geo_opt
  RUN_TYPE GEO_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    &QS
      METHOD DFTB
      &DFTB
        SELF_CONSISTENT .TRUE.
        ORTHOGONAL_BASIS .FALSE.
        DISPERSION .TRUE.
        DO_EWALD .TRUE.
        HB_SR_GAMMA .TRUE.
        &PARAMETER
          PARAM_FILE_PATH /Users/mackenziehenley/cp2k/Melamine/CP2K_mel/3ob-3-1
          PARAM_FILE_NAME scc_parameter
          UFF_FORCE_FIELD uff_table
        &END PARAMETER
      &END DFTB
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-5
      MAX_SCF 300
      &MIXING
        METHOD PULAY_MIXING
        ALPHA 0.2
        NPULAY 8
      &END MIXING
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      A     10.433000      0.000000      0.000000
      B      0.000000      7.458000      0.000000
      C     -2.862958      0.000000      6.647715
      PERIODIC XYZ
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME melamine_crystal.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY

    &KIND C
      DFTB3_PARAM -0.1492
    &END KIND
    &KIND N
      DFTB3_PARAM -0.1535
    &END KIND
    &KIND H
      DFTB3_PARAM -0.1857
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    MAX_ITER 200
    OPTIMIZER BFGS
    &BFGS
      TRUST_RADIUS 0.2
    &END BFGS
  &END GEO_OPT
  &PRINT
    &TRAJECTORY
      &EACH
        GEO_OPT 1
      &END EACH
    &END TRAJECTORY
    &RESTART
      &EACH
        GEO_OPT 10
      &END EACH
    &END RESTART
  &END PRINT
&END MOTION
