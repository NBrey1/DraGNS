&GLOBAL
  PROJECT Melamine_Opt
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    &QS
      METHOD PM6
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      MAX_SCF 200
      EPS_SCF 1.0E-5
      IGNORE_CONVERGENCE_FAILURE .TRUE.
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
  &END DFT

  &SUBSYS
    &CELL
      A  10.433000  0.000000  0.000000
      B  0.000000  7.458000  0.000000
      C  -2.862958  0.000000  6.647715
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME melamine_crystal.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &GEO_OPT
    MAX_ITER 200
    OPTIMIZER BFGS
  &END GEO_OPT
&END MOTION
